set output 'comparisons.png'
set title 'Max overlap: O(n log n) sweep line vs O(n^2) brute force'
set xlabel 'n (number of people)'
set ylabel 'comparisons'
set logscale xy
plot $DATA using 1:2 with linespoints pt 7 lw 2 title 'sweep line (measured)', \
     $DATA using 1:3 with linespoints pt 5 lw 2 title 'brute force (measured)', \
     $DATA using 1:6 with lines dt 2 lw 1.5 lc rgb 'red'  title '2n log2(2n) (theory)', \
     $DATA using 1:7 with lines dt 2 lw 1.5 lc rgb 'blue' title 'n^2 (theory)'

set output 'time.png'
set title 'Max overlap: time vs n'
set xlabel 'n (number of people)'
set ylabel 'time (seconds)'
set logscale xy
plot $DATA using 1:4 with linespoints pt 7 lw 2 title 'sweep line O(n log n)', \
     $DATA using 1:5 with linespoints pt 5 lw 2 title 'brute force O(n^2)'
